<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.contenedores</groupId>
    <artifactId>tpi-contenedores</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <!-- El packaging 'pom' indica que este es un POM padre, no un artefacto compilable. -->
    <packaging>pom</packaging>

    <!-- Módulos hijos que pertenecen a este proyecto padre. -->
    <modules>
        <module>api-gateway</module>
        <module>ms-catalogos</module>
        <module>ms-solicitudes</module>
        <module>ms-operaciones</module>
    </modules>

    <!-- Propiedades centralizadas para controlar versiones en todo el proyecto. -->
    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Versiones de Spring Boot y Spring Cloud. ¡Estas deben ser compatibles! -->
        <spring-boot.version>3.3.3</spring-boot.version>
        <!--
            CORRECCIÓN CRÍTICA: La versión 2023.1.x (Moresby) es la correcta para Spring Boot 3.3.x.
            La versión anterior (2023.0.x) era para Spring Boot 3.2.x.
        -->
        <spring-cloud.version>2023.1.2</spring-cloud.version>

        <!-- Versiones de plugins y otras dependencias comunes. -->
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <spring-boot.maven.plugin.version>${spring-boot.version}</spring-boot.maven.plugin.version>
        <lombok.version>1.18.30</lombok.version>
    </properties>

    <!--
        Dependency Management: Aquí se definen las VERSIONES de las dependencias.
        Los módulos hijos solo necesitan declarar el groupId y artifactId, y heredarán la versión de aquí.
        Esto garantiza que todos los módulos usen versiones consistentes.
    -->
    <dependencyManagement>
        <dependencies>
            <!-- Importa el Bill of Materials (BOM) de Spring Boot para gestionar sus dependencias. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Importa el BOM de Spring Cloud para gestionar sus dependencias. -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Gestiona la versión de Lombok para todos los módulos. -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        Plugin Management: Similar a dependencyManagement, pero para plugins de Maven.
        Define la configuración y versiones de los plugins que usarán los módulos hijos.
    -->
    <build>
        <pluginManagement>
            <plugins>
                <!-- Plugin de Spring Boot para empaquetar la aplicación como un JAR ejecutable. -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.maven.plugin.version}</version>
                </plugin>
                <!-- Plugin de compilación de Maven, configurado para Java 17 y Lombok. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>